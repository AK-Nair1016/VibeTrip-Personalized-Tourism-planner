# # Server
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173   (required when NODE_ENV=production; no trailing slash)

# # Database
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/vibetrip

# # JWT
# JWT_ACCESS_SECRET=change-me
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_SECRET=change-me-too
# JWT_REFRESH_EXPIRES=7d

# # Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# # Duffel (test mode token starts with duffel_test_)
# DUFFEL_API_KEY=

# # Currency conversion (rates API URL confirmed at the FX step; margin in percent)
# FX_RATES_URL=https://open.er-api.com/v6/latest
# FX_MARGIN_PERCENT=2

# # Stripe (test mode)
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_

# # Email (planned; Mailtrap in dev)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=VibeTrip <no-reply@vibetrip.dev>
