VITE_API_URL=http://localhost:5000/api

# Stripe PUBLISHABLE key only (pk_test_...). The secret key (sk_...) belongs in backend/.env, never here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe test cards (public, from Stripe's docs; they only work with test keys).
# Use any future expiry, any 3 digit CVC and any postal code.
#   4242 4242 4242 4242   payment succeeds
#   4000 0000 0000 0002   card is declined
